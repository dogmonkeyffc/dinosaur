# Defaults shown below. The program reads environment variables; it does not load .env itself.
DINOSAUR_ADDR=127.0.0.1:8096
DINOSAUR_SERVER_NAME=Dinosaur
DINOSAUR_DISCOVERY_ENABLED=true
# All application data defaults to ~/.cache/dinosaur. Override with an absolute path.
# DINOSAUR_DATA_DIR=/absolute/path/to/dinosaur
# Default: <DINOSAUR_DATA_DIR>/dinosaur.db
# DINOSAUR_DATABASE_PATH=/absolute/path/to/dinosaur/dinosaur.db
DINOSAUR_FFMPEG_PATH=ffmpeg
DINOSAUR_FFPROBE_PATH=ffprobe
DINOSAUR_SESSION_TTL=168h
DINOSAUR_REQUEST_TIMEOUT=15s
DINOSAUR_SHUTDOWN_TIMEOUT=10s
DINOSAUR_COOKIE_SECURE=false
# Set both options for HTTPS, including when TLS terminates at a reverse proxy.
# DINOSAUR_PUBLIC_URL=https://media.example.com
# DINOSAUR_COOKIE_SECURE=true
# Optional, at least 32 bytes. Otherwise generated into <data-dir>/setup-token.
# DINOSAUR_SETUP_TOKEN=replace-with-a-random-token-of-at-least-32-bytes
