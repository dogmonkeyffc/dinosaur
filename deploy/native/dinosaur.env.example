# The native installer replaces @HOME@ with the installing user's home.
DINOSAUR_ADDR=0.0.0.0:18096
DINOSAUR_DATA_DIR=@HOME@/.cache/dinosaur
DINOSAUR_FFMPEG_PATH=@HOME@/.local/share/dinosaur/current/ffmpeg
DINOSAUR_FFPROBE_PATH=@HOME@/.local/share/dinosaur/current/ffprobe
DINOSAUR_COOKIE_SECURE=false
# For HTTPS behind a reverse proxy, set both values below.
# DINOSAUR_PUBLIC_URL=https://media.example.com
# DINOSAUR_COOKIE_SECURE=true
